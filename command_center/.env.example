# Copy to .env (git-ignored) and fill in. Never commit real keys.

# --- AI agents (optional; without them the deterministic rules agents run) ---
ANTHROPIC_API_KEY=
XAI_API_KEY=
# XAI_MODEL=grok-4

# --- Alpaca PAPER trading for the stock dip desk (https://app.alpaca.markets -> Paper -> API keys) ---
# The code only talks to paper-api.alpaca.markets; these keys cannot move real money.
ALPACA_API_KEY_ID=
ALPACA_API_SECRET_KEY=

# --- API protection (set this if the port is reachable from anywhere but localhost) ---
TCC_API_TOKEN=

# --- LIVE trading (all three gates are required: station.mode=live, TCC_LIVE=1, keys) ---
# Use a sub-account. API key permissions: Read + Trade ONLY (never Withdraw), IP allow-list on.
# OKX: key + secret + the passphrase you chose when creating the key (goes in TCC_EXCHANGE_PASSWORD).
TCC_LIVE=0
TCC_EXCHANGE_KEY=
TCC_EXCHANGE_SECRET=
TCC_EXCHANGE_PASSWORD=
TCC_HB_PASSWORD=

# Only needed when running behind an HTTPS egress proxy
# TCC_EXCHANGE_PROXY=http://127.0.0.1:3128
